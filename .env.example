# Conexión a PostgreSQL. Es el único motor soportado por la API.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/api_reservas

# Base de datos separada que usan las pruebas automatizadas.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/api_reservas_test

# Entorno de ejecución: development, test o production.
APP_ENV=development

# Secreto con el que se firman los tokens JWT.
APP_JWT_SECRET=cambiar-por-un-secreto-largo-y-unico
APP_JWT_EXPIRES_MINUTES=1440

# Orígenes permitidos por CORS, separados por coma.
APP_CORS_ORIGINS=

# Nivel de detalle de los logs: DEBUG, INFO, WARNING, ERROR o CRITICAL.
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false
